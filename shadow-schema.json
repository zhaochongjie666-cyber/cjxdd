  "lifecycle_artifacts": {
    "_comment": "Single source of truth for artifact lifecycle role (Phase 1: zero-break). Consumed by: hooks/lib.sh (lifecycle_role_of / lifecycle_paths_by_role), hooks/stop-gate.sh (drift warnings), hooks/session-start.sh (role distribution), trace-init (backward trace), Reviewer chain audit. Replaces the location-only 'cross-iter vs iter-scoped' split — adds a lifecycle dimension. Edit here, not in individual hooks.",
    "roles": {
      "design_baseline":   { "label_zh": "设计基线",   "default_location": "shared",     "iter_locality": "cross_iter" },
      "process_output":    { "label_zh": "过程产物",   "default_location": "iter",       "iter_locality": "iter_local" },
      "evidence_archive":  { "label_zh": "证据存档",   "default_location": "l6_artifact","iter_locality": "iter_local" },
      "control_marker":    { "label_zh": "控制标记",   "default_location": "iter",       "iter_locality": "iter_local" },
      "template_instance": { "label_zh": "模板与实例", "default_location": "skill",      "iter_locality": "version_with_skill" }
    },
    "artifacts": [
      { "id": "l0-notebooks",                  "stage": "L0",          "canonical_path": ".shadow/L0-research/*.md",                                                                   "role": "process_output",    "aliases": [], "note": "7 份发散笔记本,L1 收敛后即弃" },
      { "id": "intent",                        "stage": "L1_Research", "canonical_path": ".shadow/L1-business/intent.md",                                                            "role": "design_baseline",   "aliases": [] },
      { "id": "business-landscape",            "stage": "L1_Research", "canonical_path": ".shadow/L1-business/business-landscape.md",                                                "role": "design_baseline",   "aliases": [] },
      { "id": "research-bxx",                  "stage": "L1_Research", "canonical_path": ".shadow/L1-business/{slug}/research.md",                                                   "role": "design_baseline",   "aliases": [] },
      { "id": "project-flow-mermaid",          "stage": "L1_Flow",     "canonical_path": ".shadow/L1-business/project.flow.mermaid",                                                "role": "design_baseline",   "aliases": [], "note": "BXX-NYY 是全传导链追溯键(最高优先)" },
      { "id": "spec-bxx",                      "stage": "L1_Spec",     "canonical_path": ".shadow/L1-business/{slug}/spec.md",                                                       "role": "design_baseline",   "aliases": [], "note": "RXX 是 L1.5/L2/L5 追溯键" },
      { "id": "wire-svg",                      "stage": "L1_Wire",     "canonical_path": ".shadow/L1-business/wire.svg",                                                            "role": "design_baseline",   "aliases": [".shadow/L1-business/wireframes/*.svg"], "note": "schema 老定义为 wireframes/*.svg,统一认 wire.svg(项目级单张)" },
      { "id": "wire-skeleton",                 "stage": "L1_Wire",     "canonical_path": ".shadow/L1-business/wire-skeleton.svg",                                                   "role": "process_output",    "aliases": [".shadow/L1-business/wire-content.svg"], "note": "Pass 1/2 中间产物,Pass 3 完成后删除" },
      { "id": "architecture-bxx",              "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/{slug}/architecture.md",                                       "role": "design_baseline",   "aliases": [".shadow/L1.5-architecture/architecture.md"], "note": ">4 业务线项目允许走单文件" },
      { "id": "event-contract",                "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/event-contract.md",                                            "role": "design_baseline",   "aliases": [] },
      { "id": "aggregate-landscape",           "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/aggregate-landscape.md",                                       "role": "design_baseline",   "aliases": [] },
      { "id": "docker-compose",                "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/{slug}/docker-compose.yml",                                   "role": "design_baseline",   "aliases": [] },
      { "id": "docker-compose-test",           "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/{slug}/docker-compose.test.yml",                              "role": "design_baseline",   "aliases": [] },
      { "id": "poc-component",                 "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/poc/{component}.md",                                           "role": "design_baseline",   "aliases": [] },
      { "id": "arch-audit-report",             "stage": "L1.5",        "canonical_path": ".shadow/L1.5-architecture/arch-audit-report.md",                                          "role": "design_baseline",   "aliases": [] },
      { "id": "e2e-bxx",                       "stage": "L2",          "canonical_path": ".shadow/L2-e2e/{slug}/e2e.md",                                                             "role": "design_baseline",   "aliases": [] },
      { "id": "coverage-matrix",               "stage": "L2",          "canonical_path": ".shadow/L2-e2e/{slug}/coverage-matrix.md",                                                "role": "design_baseline",   "aliases": [] },
      { "id": "uat-script",                    "stage": "L2",          "canonical_path": ".shadow/L2-e2e/{slug}/uat-script.md",                                                     "role": "design_baseline",   "aliases": [] },
      { "id": "failure-modes",                 "stage": "L3",          "canonical_path": ".shadow/L3-resilience/{slug}/failure-modes.md",                                          "role": "design_baseline",   "aliases": [] },
      { "id": "failsafe-design",               "stage": "L3",          "canonical_path": ".shadow/L3-resilience/{slug}/failsafe-design.md",                                        "role": "design_baseline",   "aliases": [".shadow/L3-resilience/{slug}/policies.md"], "note": "cjxdd/demo 叫 policies.md,统一认 failsafe-design.md" },
      { "id": "chaos-scenarios",               "stage": "L3",          "canonical_path": ".shadow/L3-resilience/{slug}/chaos-scenarios.md",                                        "role": "design_baseline",   "aliases": [".shadow/L3-resilience/{slug}/chaos-experiments.md"], "note": "cjxdd/demo 叫 chaos-experiments.md,统一认 chaos-scenarios.md" },
      { "id": "resilience-test-plan",          "stage": "L3",          "canonical_path": ".shadow/L3-resilience/{slug}/resilience-test-plan.md",                                   "role": "design_baseline",   "aliases": [".shadow/L3-resilience/{slug}/resilience-test-matrix.md"], "note": "cjxdd/demo 叫 resilience-test-matrix.md,统一认 resilience-test-plan.md" },
      { "id": "recovery-runbook",              "stage": "L3",          "canonical_path": ".shadow/L3-resilience/{slug}/recovery-runbook.md",                                       "role": "design_baseline",   "aliases": [] },
      { "id": "harness-plan",                  "stage": "L5_Plan",     "canonical_path": ".shadow/L5-plan/{slug}/harness-plan.md",                                                 "role": "design_baseline",   "aliases": [], "note": "文件本身是设计基线(约束段/批次顺序跨迭代有效);指令段是过程产物但依附于文件保留" },
      { "id": "plan-impl-diff-report",         "stage": "L5_Plan",     "canonical_path": ".shadow/L5-plan/plan-impl-diff-report.md",                                                "role": "control_marker",    "aliases": [], "note": "plan vs code 偏差证据" },
      { "id": "code-skeleton",                 "stage": "L5_Impl",     "canonical_path": "backend/**/skeleton.*",                                                                    "role": "process_output",    "aliases": ["frontend/**/skeleton.*"], "note": "L5-impl 起点,被覆盖填实" },
      { "id": "e2e-step-binding",              "stage": "L5_Impl",     "canonical_path": "e2e/{feature}.binding.yaml",                                                              "role": "process_output",    "aliases": [], "note": "未填实是过程产物,填实后转设计基线" },
      { "id": "coverage-tracker",              "stage": "L5_Impl",     "canonical_path": "e2e/coverage-tracker.json",                                                                "role": "process_output",    "aliases": [], "note": "累积状态,每次跑更新" },
      { "id": "reviewer-report",               "stage": "Reviewer",    "canonical_path": ".shadow/iterations/{iter}/reviews/{type}-review-{slug}-{ts}.md",                          "role": "process_output",    "aliases": [".shadow/reviewer/{slug}/review-report.md", ".shadow/iterations/{iter}/gate/reviewer-report.md"], "note": "schema 老定义 reviewer/{slug}/review-report.md,统一认 SKILL 路径" },
      { "id": "gate-result-json",              "stage": "Reviewer",    "canonical_path": ".shadow/iterations/{iter}/gate/{layer}.{slug}.result.json",                               "role": "process_output",    "aliases": [] },
      { "id": "gate-passed-marker",            "stage": "Reviewer",    "canonical_path": ".shadow/iterations/{iter}/gate/{layer}.{slug}.passed",                                   "role": "control_marker",    "aliases": [] },
      { "id": "feature-status-marker",         "stage": "Reviewer",    "canonical_path": ".shadow/iterations/{iter}/feature-status/{slug}/BXX-NYY.done",                           "role": "control_marker",    "aliases": [".shadow/L5-plan/{slug}/feature-status/BXX-NYY.done", ".shadow/iterations/{iter}/feature-status/BXX-NYY.done"], "note": "3 派位置共存,统一认迭代作用域" },
      { "id": "work-order",                    "stage": "infra",       "canonical_path": ".shadow/iterations/{iter}/work-orders/WO-NNN-{slug}.md",                                 "role": "process_output",    "aliases": [] },
      { "id": "work-order-report",             "stage": "infra",       "canonical_path": ".shadow/iterations/{iter}/work-orders/WO-NNN-{slug}/report.md",                          "role": "process_output",    "aliases": [] },
      { "id": "failure-log",                   "stage": "infra",       "canonical_path": ".shadow/iterations/{iter}/FAI3URE-3OG.md",                                               "role": "process_output",    "aliases": [], "note": "4 次失败时的一次性日志" },
      { "id": "status-md",                     "stage": "infra",       "canonical_path": ".shadow/iterations/{iter}/pipeline/status.md",                                           "role": "process_output",    "aliases": [] },
      { "id": "l6-deployment-report",          "stage": "L6",          "canonical_path": ".shadow/iterations/{iter}/L6-deploy/{slug}/deployment-report.md",                         "role": "process_output",    "aliases": [".shadow/L6-deploy/{slug}/deploy-report.md", ".shadow/L6-deploy/{slug}/deployment-report.md"], "note": "部署报告内部 evidence 段是 evidence_archive 角色" },
      { "id": "wander-evidence",               "stage": "L6",          "canonical_path": ".shadow/iterations/{iter}/L6-deploy/{slug}/wander-evidence/",                            "role": "evidence_archive",  "aliases": [".shadow/L6-deploy/{slug}/wander-evidence/"] },
      { "id": "chaos-drill-evidence",          "stage": "L6",          "canonical_path": ".shadow/iterations/{iter}/L6-deploy/{slug}/chaos-drill-evidence/",                       "role": "evidence_archive",  "aliases": [] },
      { "id": "issues-json",                   "stage": "L6",          "canonical_path": ".shadow/iterations/{iter}/L6-deploy/{slug}/issues.json",                                "role": "evidence_archive",  "aliases": [".shadow/L6-deploy/{slug}/issues.json"] },
      { "id": "l6-gate-passed",                "stage": "L6",          "canonical_path": ".shadow/iterations/{iter}/gate/l6.{slug}.passed",                                        "role": "control_marker",    "aliases": [".shadow/L6-deploy/{slug}/l6.deploy.passed"] },
      { "id": "index-md",                      "stage": "infra",       "canonical_path": ".shadow/INDEX.md",                                                                          "role": "control_marker",    "aliases": [], "note": "由 trace-init 产,跨迭代追溯基础设施" },
      { "id": "lifecycle-md",                  "stage": "infra",       "canonical_path": ".shadow/LIFECYCLE.md",                                                                       "role": "control_marker",    "aliases": [], "note": "由 shadow-init 产,项目内生命周期索引;存在 = 新项目,R5 硬门禁启用" },
      { "id": "trace-md",                      "stage": "infra",       "canonical_path": ".shadow/TRACE.md",                                                                          "role": "control_marker",    "aliases": [] },
      { "id": "shadow-version",                "stage": "infra",       "canonical_path": ".shadow/SHADOW_VERSION",                                                                    "role": "control_marker",    "aliases": [] },
      { "id": "current-iter",                  "stage": "infra",       "canonical_path": ".shadow/current-iteration",                                                                "role": "control_marker",    "aliases": [] },
      { "id": "scale-md",                      "stage": "infra",       "canonical_path": ".shadow/scale.md",                                                                          "role": "control_marker",    "aliases": [], "note": "虽是控制标记,但被 5 个下游 skill 读,具有 design_baseline 的一些属性" },
      { "id": "scaffold-verified",             "stage": "Scaffold",    "canonical_path": "scaffold.verified",                                                                         "role": "control_marker",    "aliases": [] },
      { "id": "reverse-complete",              "stage": "infra",       "canonical_path": ".shadow/reverse-complete",                                                                 "role": "control_marker",    "aliases": [], "note": "一次性握手信号" },
      { "id": "tpl-l1p5-architecture",         "stage": "L1.5",        "canonical_path": "skills/shadow-l1p5-architecture/templates/architecture-template.md",                     "role": "template_instance", "aliases": [], "note": "模板;实例 = architecture.md (设计基线)" },
      { "id": "tpl-l1p5-filelist",             "stage": "L1.5",        "canonical_path": "skills/shadow-l1p5-architecture/templates/filelist-template.md",                         "role": "template_instance", "aliases": [] },
      { "id": "tpl-l1p5-quality",              "stage": "L1.5",        "canonical_path": "skills/shadow-l1p5-architecture/templates/quality-template.md",                          "role": "template_instance", "aliases": [] },
      { "id": "tpl-l3-failure-modes",          "stage": "L3",          "canonical_path": "skills/shadow-l3-resilience/templates/failure-modes.md",                                 "role": "template_instance", "aliases": [] },
      { "id": "tpl-l3-failsafe-design",        "stage": "L3",          "canonical_path": "skills/shadow-l3-resilience/templates/failsafe-design.md",                               "role": "template_instance", "aliases": [] },
      { "id": "tpl-l3-chaos-scenarios",        "stage": "L3",          "canonical_path": "skills/shadow-l3-resilience/templates/chaos-scenarios.md",                               "role": "template_instance", "aliases": [] },
      { "id": "tpl-l3-resilience-test-plan",   "stage": "L3",          "canonical_path": "skills/shadow-l3-resilience/templates/resilience-test-plan.md",                          "role": "template_instance", "aliases": [] },
      { "id": "tpl-l3-recovery-runbook",       "stage": "L3",          "canonical_path": "skills/shadow-l3-resilience/templates/recovery-runbook.md",                              "role": "template_instance", "aliases": [] },
      { "id": "tpl-l5-harness-plan",           "stage": "L5_Plan",     "canonical_path": "skills/shadow-l5-plan/templates/harness-plan-template.md",                               "role": "template_instance", "aliases": [] },
      { "id": "tpl-l6-deployment-report",      "stage": "L6",          "canonical_path": "skills/shadow-l6-deploy/templates/L6.md",                                                  "role": "template_instance", "aliases": [] }
    ]
  },

  "stub_patterns": {
    "_comment": "Walker hard rule #1 (no stubs) + #2 (no fake impls). Each pattern is a regex passed to grep -E.",
    "patterns": [
      "^\\s*pass\\s*$",
      "TODO",
      "FIXME",
      "raise NotImplementedError",
      "InMemoryRepository",
      "InMemoryEventBus",
      "current_user\\s*=\\s*[\"'\\'']admin[\"'\\'']"
    ],
    "ext_globs": [
      "*.py", "*.ts", "*.tsx", "*.js", "*.jsx",
      "*.go", "*.java", "*.kt", "*.rs"
    ],
    "excluded_dirs": [
      ".venv", "node_modules", "__pycache__",
      "dist", "build", ".git", "target", ".shadow"
    ],
    "min_file_size_bytes": 300,
    "max_findings_per_file": 10
  },

  "scale_schema": {
    "_comment": "Schema for .shadow/scale.md. Consumed by 5 skills (see CLAUDE.md). shadow-init writes a default-valorized scale.md; walker fills in real values during the 规模判定 step.",
    "fields": {
      "scale":               { "type": "string",  "enum": ["S", "M", "L"], "default": "M" },
      "persona_dimensions":  { "type": "integer", "min": 3, "max": 12,       "default": 6 },
      "persona_max":         { "type": "integer", "min": 3, "max": 20,       "default": 8 },
      "wire_passes":         { "type": "integer", "min": 1, "max": 5,        "default": 3 },
      "coverage_dimensions": { "type": "integer", "min": 5, "max": 30,       "default": 14 },
      "l3_required":         { "type": "boolean",                          "default": true },
      "l3_extended_mode":    { "type": "boolean",                          "default": false },
      "l6_core_phases_only": { "type": "boolean",                          "default": false }
    }
  },

  "status_md": {
    "version": 1,
    "markers": {
      "pending": "⏳",
      "doing":   "🔄",
      "done":    "✅",
      "failed":  "❌"
    },
    "stage_row_regex":   "^\\|\\s*L.*\\|",
    "bxx_section_regex": "^## B[0-9]",
    "last_updated_field": "last_updated"
  },

  "shadow_init": {
    "_comment": "What shadow-init should scaffold on first run.",
    "required_files": [
      "SHADOW_VERSION",
      "iterations/iter-1/pipeline/status.md",
      "scale.md",
      "L0-research/.gitkeep"
    ],
    "default_bizlines": [],
    "status_md_template_header": [
      "# Pipeline Status — iter-1",
      "",
      "last_updated: {{iso_date}}",
      "shadow_version: {{shadow_version}}",
      "",
      "> Per-stage table below. Mark each row with ⏳ pending / 🔄 doing / ✅ done / ❌ failed.",
      "> For multi-bizline projects, replace the single table with `## BXX 业务线名` sections.",
      ""
    ],
    "status_md_template_table": [
      "| 阶段 | 状态 | 产出 | 自检 |",
      "|------|------|------|------|",
      "| L0 | ⏳ | — | — |",
      "| L1 Research | ⏳ | — | — |",
      "| L1 Flow | ⏳ | — | — |",
      "| L1 Spec | ⏳ | — | — |",
      "| L1 Wire | ⏳ | — | — |",
      "| L1.5 | ⏳ | — | — |",
      "| Scaffold | ⏳ | — | — |",
      "| L2 | ⏳ | — | — |",
      "| L3 | ⏳ | failure-modes / failsafe-design / chaos-scenarios / resilience-test-plan / recovery-runbook | gate-check-l3.sh |",
      "| L5 Plan | ⏳ | — | — |",
      "| L5 Impl | ⏳ | — | — |",
      "| 全链路审查 | ⏳ | — | — |",
      "| L6 | ⏳ | — | — |",
      ""
    ]
  }
}
