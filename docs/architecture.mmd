    classDef biz fill:#1E293B,stroke:#64748B,color:#E2E8F0,stroke-width:1.5px
    classDef L3ext fill:#4A1D24,stroke:#FB7185,color:#FFE4E6,stroke-width:2px,stroke-dasharray: 5 3
    classDef scale fill:#4A1D24,stroke:#FB7185,color:#FFE4E6,stroke-width:2px
