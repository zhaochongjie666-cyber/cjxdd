    },
    {
      "id": "Reviewer",
      "num": 11,
      "display": "全链路审查",
      "skill": "shadow-reviewer",
      "aliases": ["全链路审查", "Reviewer", "reviewer"],
      "output_patterns": [".shadow/reviewer/{slug}/review-report.md"]
    },
    {
      "id": "L6",
      "num": 12,
      "display": "L6",
