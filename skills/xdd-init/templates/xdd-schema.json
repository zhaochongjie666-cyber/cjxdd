{
  "xdd_version": "0.1.0",
  "directory_layout": {
    "comment": "6 目录扁平结构 (baseline 内 6 子目录) — 老结构 9 子目录合并为 6, 删 intent/add/business",
    "root": {
      "baseline/": "design_baseline 全部 (research/bdd/flow/arch/wire/resilience — 6 子目录)",
      "gates/": "control_marker 全部 (scale.md / current-iteration / xdd-version / .xdd-halt.json / .l5-unresolved.json)"
    },
    "iter": {
      "comment": "per-iter 全部, 收尾后 frozen, iter-N+1/.inherited/ 收 halt/unresolved",
      "iterations/iter-N/": "全部 per-iter 工件 (pipeline / plan / research / verify / execute / chaos / wire-reviews / gate-logs / reports / bdd-trace / design)"
    }
  },
  "stages": [
    {
      "id": "0_INIT",
      "num": 0,
      "display": "0 INIT",
      "skill": "xdd-init",
      "aliases": ["0", "init", "0 init"],
      "output_patterns": [
        "./.xdd/",
        "./.xdd/gates/scale.md",
        "./.xdd/gates/current-iteration",
        "./.xdd/gates/xdd-version",
        "./.xdd/baseline/research/00-intent.md",
        "./.xdd/iterations/iter-1/pipeline/status.md"
      ]
    },
    {
      "id": "1_RESEARCH",
      "num": 1,
      "display": "1 RESEARCH",
      "skill": "xdd-l0",
      "aliases": ["1", "research", "1 research"],
      "output_patterns": [
        "./.xdd/baseline/research/{00-intent,00-l1-recap,01-customer,02-product,03-tech,04-business-model,05-data,06-risk,07-competitor,08-brainstorm}.md"
      ]
    },
    {
      "id": "2_DESIGN",
      "num": 2,
      "display": "2 DESIGN",
      "skill": "xdd-bdd",
      "aliases": ["2", "design", "2 design"],
      "output_patterns": [
        "./.xdd/baseline/bdd/_landscape.md",
        "./.xdd/baseline/bdd/{slug}/business.md",
        "./.xdd/baseline/bdd/{slug}/spec.md",
        "./.xdd/baseline/bdd/{slug}/*.feature",
        "./.xdd/baseline/flow/{slug}.mermaid",
        "./.xdd/baseline/wire/{page}/index.html",
        "./.xdd/baseline/wire/{page}/index.mobile.html"
      ]
    },
    {
      "id": "2.5_ARCH",
      "num": 3,
      "display": "2.5 Arch",
      "skill": "xdd-arch",
      "aliases": ["2.5", "arch", "2.5 arch"],
      "output_patterns": [
        "./.xdd/baseline/arch/{slug}/architecture.md",
        "./.xdd/baseline/arch/aggregate-landscape.md",
        "./.xdd/baseline/arch/event-contract.md",
        "./.xdd/baseline/arch/{slug}/docker-compose.yml",
        "./.xdd/baseline/arch/{slug}/docker-compose.test.yml"
      ]
    },
    {
      "id": "2.7_SCAFFOLD",
      "num": 4,
      "display": "2.7 Scaffold",
      "skill": "xdd-scaffold",
      "aliases": ["2.7", "scaffold"],
      "output_patterns": [
        "./docker-compose.yml",
        "./docker-compose.dev.yml",
        "./.env.example",
        "./migrations/*.sql"
      ]
    },
    {
      "id": "3_L3",
      "num": 5,
      "display": "3 L3",
      "skill": "xdd-l3",
      "aliases": ["3", "l3", "3 l3"],
      "output_patterns": [
        "./.xdd/baseline/resilience/{slug}/failure-modes.md",
        "./.xdd/baseline/resilience/{slug}/failsafe-design.md",
        "./.xdd/baseline/resilience/{slug}/chaos-scenarios.md",
        "./.xdd/baseline/resilience/{slug}/resilience-test-plan.md",
        "./.xdd/baseline/resilience/{slug}/recovery-runbook.md"
      ]
    },
    {
      "id": "3_REVIEW",
      "num": 6,
      "display": "3 Review",
      "skill": null,
      "aliases": ["3 review", "review"],
      "output_patterns": []
    },
    {
      "id": "4_PLAN",
      "num": 7,
      "display": "4 Plan",
      "skill": "xdd-plan",
      "aliases": ["4", "plan", "4 plan"],
      "output_patterns": [
        "./.xdd/iterations/iter-1/plan/harness-plan.md",
        "./.xdd/iterations/iter-1/plan/{feature}.md"
      ]
    },
    {
      "id": "5_EXECUTE",
      "num": 8,
      "display": "5 Execute",
      "skill": "xdd-execute",
      "aliases": ["5", "execute", "5 execute"],
      "output_patterns": [
        "./{src,backend,frontend,lib,internal}/**/*.{ts,tsx,js,jsx,py,go,java,kt,rs}",
        "./tests/**/*.test.*",
        "./tests/**/test_*.py"
      ]
    },
    {
      "id": "6_VERIFY",
      "num": 9,
      "display": "6 Verify",
      "skill": "xdd-l6",
      "aliases": ["6", "verify", "l6", "6 verify"],
      "output_patterns": [
        "./.xdd/iterations/iter-1/verify/{slug}/deployment-report.md",
        "./.xdd/iterations/iter-1/verify/{slug}/smoke-test-passed",
        "./.xdd/iterations/iter-1/verify/{slug}/l5-{correctness,security,performance,maintainability}.md"
      ]
    }
  ],
  "stub_patterns": {
    "patterns": [
      "^[[:space:]]*pass[[:space:]]*$",
      "^[[:space:]]*TODO",
      "^[[:space:]]*FIXME",
      "^[[:space:]]*NotImplementedError",
      "^[[:space:]]*raise[[:space:]]+NotImplementedError",
      "InMemoryRepository",
      "MockDB",
      "current_user[[:space:]]*=[[:space:]]*[\"']admin[\"']"
    ],
    "ext_globs": [
      "*.py", "*.ts", "*.tsx", "*.js", "*.jsx", "*.go", "*.java", "*.kt", "*.rs"
    ],
    "excluded_dirs": [
      "node_modules", ".venv", "__pycache__", "dist", "build", "target", ".git", ".shadow", ".xdd"
    ],
    "min_file_size_bytes": 300,
    "max_findings_per_file": 10
  },
  "scale_schema": {
    "fields": {
      "scale": { "type": "enum", "enum": ["S", "M", "L", "XL"], "default": "L" },
      "strict_mode": { "type": "boolean", "default": true },
      "l0_required": { "type": "boolean", "default": true },
      "l3_required": { "type": "boolean", "default": true },
      "l6_required": { "type": "boolean", "default": true },
      "scaffold_required": { "type": "boolean", "default": true },
      "bxx_enabled": { "type": "boolean", "default": false },
      "persona_max": { "type": "integer", "default": 12 },
      "persona_dimensions": { "type": "integer", "default": 8 },
      "coverage_dimensions": { "type": "integer", "default": 20 },
      "wire_passes": { "type": "integer", "default": 4 },
      "l3_extended_mode": { "type": "boolean", "default": true },
      "no_advisory": { "type": "boolean", "default": true },
      "halt_after": { "type": "integer", "default": 3 }
    }
  },
  "status_md": {
    "version": 1,
    "markers": {
      "pending": "⏳",
      "doing": "🔄",
      "done": "✅",
      "failed": "❌"
    },
    "stage_row_regex": "^\\|\\s*\\d",
    "bxx_section_regex": "^##\\s+B\\d+",
    "last_updated_field": "last_updated"
  },
  "xdd_init": {
    "required_files": [
      "gates/xdd-version",
      "gates/current-iteration",
      "iterations/iter-1/pipeline/status.md",
      "gates/scale.md"
    ],
    "required_when_bxx": [
      "baseline/bdd/_landscape.md",
      "baseline/bdd/{BXX-slug}/business.md (per BXX)"
    ],
    "bizline_placeholder_template": "# {BXX_id} {BXX_name}\n\n> 业务线说明 — 目标 + 关键问题 + 范围.\n\n## 业务目标\n\n- {目标 1}\n- {目标 2}\n\n## 关键问题\n\n1. {问题 1}\n2. {问题 2}\n\n## 范围\n\n- in-scope: {范围内}\n- out-of-scope: {范围外}\n\n## 关联\n\n- RXX 规则: {R01, R02, ...}\n- Arch 设计 (含运维视图): baseline/arch/{slug}/architecture.md\n- Resilience: baseline/resilience/{slug}/failure-modes.md\n",
    "default_bizlines": [],
    "status_md_template_header": [
      "# Pipeline Status — iter-1",
      "",
      "last_updated: {{ts}}",
      "xdd_version: 0.1.0",
      "strict_mode: true"
    ],
    "status_md_template_table": [
      "| Phase | 状态 | 备注 |",
      "|-------|------|------|",
      "| 0 INIT | ⏳ |  |",
      "| 1 RESEARCH | ⏳ |  |",
      "| 2 DESIGN | ⏳ |  |",
      "| 2.5 BDD | ⏳ |  |",
      "| 2.7 SCAFFOLD | ⏳ |  |",
      "| 3 L3 | ⏳ |  |",
      "| 3 Review | ⏳ |  |",
      "| 4 Plan | ⏳ |  |",
      "| 5 Execute | ⏳ |  |",
      "| 6 Verify | ⏳ |  |"
    ]
  },
  "lifecycle_artifacts": {
    "roles": {
      "design_baseline": "设计基线 — 跨迭代累积, 原位修改, 改后必触发 L3/L5/L6 重跑",
      "process_output": "过程产物 — 一次性消费, iter 冻结",
      "evidence_archive": "证据存档 — 只读不可变, 加 .archived 锁",
      "control_marker": "控制标记 — 空文件/单行, 跟生命周期绑定",
      "template_instance": "模板与实例 — 模板跟 skill, 实例跟项目"
    },
    "artifacts": [
      { "id": "intent", "stage": "0_INIT", "role": "design_baseline", "canonical_path": "./.xdd/baseline/research/00-intent.md" },
      { "id": "scale", "stage": "0_INIT", "role": "control_marker", "canonical_path": "./.xdd/gates/scale.md" },
      { "id": "xdd-version", "stage": "0_INIT", "role": "control_marker", "canonical_path": "./.xdd/gates/xdd-version" },
      { "id": "current-iteration", "stage": "0_INIT", "role": "control_marker", "canonical_path": "./.xdd/gates/current-iteration" },
      { "id": "xdd-halt", "stage": "ANY", "role": "control_marker", "canonical_path": "./.xdd/gates/.xdd-halt.json" },
      { "id": "l5-unresolved", "stage": "6_VERIFY", "role": "control_marker", "canonical_path": "./.xdd/gates/.l5-unresolved.json" },
      { "id": "status-md", "stage": "0_INIT", "role": "process_output", "canonical_path": "./.xdd/iterations/iter-1/pipeline/status.md" },
      { "id": "l0-notebooks", "stage": "1_RESEARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/research/{00-intent,00-l1-recap,01-customer,02-product,03-tech,04-business-model,05-data,06-risk,07-competitor,08-brainstorm}.md" },
      { "id": "research-snapshot", "stage": "1_RESEARCH", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/research/{00-intent,00-l1-recap,01-customer,02-product,03-tech,04-business-model,05-data,06-risk,07-competitor,08-brainstorm}.md" },
      { "id": "business-landscape", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/bdd/_landscape.md" },
      { "id": "business-slug", "stage": "2_DESIGN", "role": "template_instance", "canonical_path": "./.xdd/baseline/bdd/{slug}/business.md" },
      { "id": "spec", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/bdd/{slug}/spec.md" },
      { "id": "bdd-feature", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/bdd/{slug}/*.feature" },
      { "id": "flow-mermaid", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/flow/{slug}.mermaid" },
      { "id": "wire-html", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/wire/{page}/{index.html,index.mobile.html,error.html,loading.html,success.html,review.md}" },
      { "id": "wire-svg", "stage": "2_DESIGN", "role": "design_baseline", "canonical_path": "./.xdd/baseline/wire/{page}.svg" },
      { "id": "architecture", "stage": "2.5_ARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/arch/{slug}/architecture.md" },
      { "id": "aggregate-landscape", "stage": "2.5_ARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/arch/aggregate-landscape.md" },
      { "id": "event-contract", "stage": "2.5_ARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/arch/event-contract.md" },
      { "id": "docker-compose", "stage": "2.5_ARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/arch/{slug}/docker-compose.yml" },
      { "id": "docker-compose-test", "stage": "2.5_ARCH", "role": "design_baseline", "canonical_path": "./.xdd/baseline/arch/{slug}/docker-compose.test.yml" },
      { "id": "failure-modes", "stage": "3_L3", "role": "design_baseline", "canonical_path": "./.xdd/baseline/resilience/{slug}/failure-modes.md" },
      { "id": "failsafe-design", "stage": "3_L3", "role": "design_baseline", "canonical_path": "./.xdd/baseline/resilience/{slug}/failsafe-design.md" },
      { "id": "chaos-scenarios", "stage": "3_L3", "role": "design_baseline", "canonical_path": "./.xdd/baseline/resilience/{slug}/chaos-scenarios.md" },
      { "id": "resilience-test-plan", "stage": "3_L3", "role": "design_baseline", "canonical_path": "./.xdd/baseline/resilience/{slug}/resilience-test-plan.md" },
      { "id": "recovery-runbook", "stage": "3_L3", "role": "design_baseline", "canonical_path": "./.xdd/baseline/resilience/{slug}/recovery-runbook.md" },
      { "id": "plan", "stage": "4_PLAN", "role": "process_output", "canonical_path": "./.xdd/iterations/iter-1/plan/harness-plan.md" },
      { "id": "plan-feature", "stage": "4_PLAN", "role": "process_output", "canonical_path": "./.xdd/iterations/iter-1/plan/{feature}.md" },
      { "id": "code", "stage": "5_EXECUTE", "role": "design_baseline", "canonical_path": "./{src,backend,frontend,lib,internal}/**/*.{ts,tsx,js,jsx,py,go,java,kt,rs}" },
      { "id": "tests", "stage": "5_EXECUTE", "role": "design_baseline", "canonical_path": "./{tests,test,__tests__}/**/*.{test,spec}.{ts,tsx,js,jsx,py,go,java,kt,rs}" },
      { "id": "verify-l5", "stage": "6_VERIFY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/verify/l5-{correctness,security,performance,maintainability}.md" },
      { "id": "verify-health", "stage": "6_VERIFY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/verify/health-check.md" },
      { "id": "verify-wander", "stage": "6_VERIFY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/verify/wander-test.md" },
      { "id": "verify-dual-contract", "stage": "6_VERIFY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/verify/dual-contract-verification.md" },
      { "id": "verify-r11", "stage": "6_VERIFY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/verify/r11-production-contract.md" },
      { "id": "deployment-report", "stage": "6_VERIFY", "role": "process_output", "canonical_path": "./.xdd/iterations/iter-1/verify/deployment-report.md" },
      { "id": "final-report", "stage": "6_VERIFY", "role": "process_output", "canonical_path": "./.xdd/iterations/iter-1/verify/final-report.md" },
      { "id": "smoke-test-passed", "stage": "6_VERIFY", "role": "control_marker", "canonical_path": "./.xdd/iterations/iter-1/verify/smoke-test-passed" },
      { "id": "wire-review", "stage": "2_DESIGN", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/wire-reviews/{page}/review.md" },
      { "id": "exec-loop-log", "stage": "5_EXECUTE", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/execute/exec-loop-*.log" },
      { "id": "chaos-log", "stage": "3_L3", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/chaos/chaos-loop-*.log" },
      { "id": "gate-log", "stage": "ANY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/gate-logs/{wire-validate,ux-check,coverage-check,stub-scan,lifecycle-gate}.log" },
      { "id": "session-report", "stage": "ANY", "role": "evidence_archive", "canonical_path": "./.xdd/iterations/iter-1/reports/{bug-report,design-review,coverage-snapshot}-{id,date,ts}.md" },
      { "id": "skill-templates", "stage": "0_INIT", "role": "template_instance", "canonical_path": "skills/{name}/templates/*.md" }
    ]
  }
}
