{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-user-prompt-submit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-pre-skill.sh"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-team-dispatch.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-stub-scan.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/xdd-gate-stop.sh"
          }
        ]
      }
    ]
  },
  "_comment": "xdd — Claude Code hook configuration. Auto-loaded when CWD is inside this project. Hook scripts live in ./hooks/ (repo root) and are symlinked to ~/.claude/hooks/ by install-to-claude-code.sh. All hook names use xdd-gate-* prefix (no shadow-* legacy).",
  "skipDangerousModePermissionPrompt": true
}
