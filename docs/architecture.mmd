%%{ init: { 'theme': 'dark' } }%%
flowchart TB
  subgraph Entry["入口"]
    INIT["xdd-init\n生成 .xdd/ 骨架"]
  end

  subgraph Design["设计层（锚）—— 把用户意图固化"]
    direction TB
    UND["xdd-understand\n意图锚\nintent.md + design.md"]
    SPEC["xdd-spec\n规则锚 RXX\nrules.md + *.feature"]
    ARCH["xdd-architecture\n结构锚\narchitecture.md + flow.mermaid\n+ 端点/事件契约 + 运维"]
    WIRE["xdd-wire\n前端锚\n6 操作态 + review\n(纯后端跳过)"]
    RES["xdd-resilience\n韧性锚\n失败模式 + 兜底 + 混沌"]
    UND --> SPEC --> ARCH --> WIRE --> RES
  end

  subgraph Bridge["桥接"]
    PLAN["xdd-plan\n设计→TDD计划\n每个 task 回指 RXX"]
  end

  subgraph Code["代码层"]
    direction TB
    EXE["xdd-execute\n写代码 @implements RXX\nTDD + 无存根"]
    VER["xdd-verify\n真实验证\n双契约 + 4维一致性"]
    EXE --> VER
  end

  USER["👤 用户 prompt"] --> INIT
  INIT --> UND
  RES --> PLAN
  PLAN --> EXE

  %% 追溯闭环
  VER -. "代码 @implements RXX → plan task → spec 规则 → design 意图" .-> UND

  %% 用户审查节点
  UND -. "停下给用户审 design.md" .-> USER

  classDef entry fill:#1e3a5f,stroke:#3b82f6,color:#fff
  classDef design fill:#1a4d2e,stroke:#22c55e,color:#fff
  classDef bridge fill:#4d3a1a,stroke:#f59e0b,color:#fff
  classDef code fill:#4d1a2e,stroke:#ec4899,color:#fff
  classDef user fill:#3b1a4d,stroke:#a855f7,color:#fff

  class INIT entry
  class UND,SPEC,ARCH,WIRE,RES design
  class PLAN bridge
  class EXE,VER code
  class USER user
