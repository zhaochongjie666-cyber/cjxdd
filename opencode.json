{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": "allow",
    "glob": "allow"
  },
  "provider": {
    "minimax": {
      "api": "openai-completions",
      "options": {
        "apiKey": "${MINIMAX_API_KEY}",
        "baseURL": "https://api.minimaxi.com/v1"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax M2.7",
          "reasoning": true,
          "limit": {
            "context": 204800,
            "output": 131072
          }
        }
      }
    },
    "4sapi": {
      "api": "openai-responses",
      "options": {
        "apiKey": "${4SAPI_API_KEY}",
        "baseURL": "https://4sapi.com/v1"
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4 (4S API)",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 131072
          }
        }
      }
    },
    "aliyun-token-plan": {
      "api": "openai-completions",
      "options": {
        "apiKey": "${ALIYUN_TOKEN_PLAN_API_KEY}",
        "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "qwen3.6-plus": {
          "name": "Qwen3.6-Plus",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6-Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v3.2": {
          "name": "DeepSeek V3.2",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-5": {
          "name": "GLM-5",
          "reasoning": true,
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "MiniMax-M2.5": {
          "name": "MiniMax-M2.5",
          "reasoning": true,
          "limit": {
            "context": 204800,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "MiniMax": {
      "type": "local",
      "command": ["uvx", "minimax-coding-plan-mcp", "-y"],
      "environment": {
        "MINIMAX_API_KEY": "${MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com"
      },
      "enabled": true
    },
    "Shadow": {
      "type": "local",
      "command": [
        "node",
        "/home/zhaocj/ws/pi-skills/pi-extensions/shadow-mcp/server.js"
      ],
      "enabled": true
    }
  }
}
