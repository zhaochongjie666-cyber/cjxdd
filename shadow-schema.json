{
  "shadow_version": "0.2.0",
  "_comment": "Single source of truth for the Shadow framework. Consumed by: hooks/*.sh (via jq), plugins/shadow-hooks.ts (via readFileSync+JSON.parse), and shadow-init skill (to generate .shadow/ skeleton). Edit here, not in individual hooks.",

  "stages": [
    {
      "id": "L0",
      "num": 0,
      "display": "L0",
      "skill": "shadow-l0-research",
      "aliases": ["L0", "l0"],
      "output_patterns": [".shadow/L0-research/*.md"]
    },
    {
      "id": "L1_Research",
      "num": 1,
      "display": "L1 Research",
      "skill": "shadow-l1-research",
      "aliases": ["L1 Research", "L1_Research", "l1 research", "l1_research"],
      "output_patterns": [
        ".shadow/L1-business/{slug}/intent.md",
        ".shadow/L1-business/{slug}/business-landscape.md"
      ]
    },
    {
      "id": "L1_Flow",
      "num": 2,
      "display": "L1 Flow",
      "skill": "shadow-l1-flow",
      "aliases": ["L1 Flow", "L1_Flow", "l1 flow", "l1_flow"],
      "output_patterns": [".shadow/L1-business/project.flow.mermaid"]
    },
    {
      "id": "L1_Spec",
      "num": 3,
      "display": "L1 Spec",
      "skill": "shadow-l1-spec",
      "aliases": ["L1 Spec", "L1_Spec", "l1 spec", "l1_spec"],
      "output_patterns": [".shadow/L1-business/{slug}/spec.md"]
    },
    {
      "id": "L1_Wire",
      "num": 4,
      "display": "L1 Wire",
      "skill": "shadow-l1-wire",
      "aliases": ["L1 Wire", "L1_Wire", "l1 wire", "l1_wire"],
      "output_patterns": [".shadow/L1-business/{slug}/wireframes/*.svg"]
    },
    {
      "id": "L1.5",
      "num": 5,
      "display": "L1.5",
      "skill": "shadow-l1p5-architecture",
      "aliases": ["L1.5", "L1P5", "l1.5", "l1p5"],
      "output_patterns": [".shadow/L1.5-architecture/{slug}/architecture.md"]
    },
    {
      "id": "Scaffold",
      "num": 6,
      "display": "Scaffold",
      "skill": "shadow-scaffold",
      "aliases": ["Scaffold", "scaffold"],
      "output_patterns": ["Dockerfile"]
    },
    {
      "id": "L2",
      "num": 7,
      "display": "L2",
      "skill": "shadow-l2-e2e",
      "aliases": ["L2", "l2"],
      "output_patterns": [".shadow/L2-e2e/{slug}/uat-script.md"]
    },
    {
      "id": "L3",
      "num": 8,
      "display": "L3",
      "skill": "shadow-l3-resilience",
      "aliases": ["L3", "l3", "L3 Resilience", "L3_Resilience", "l3 resilience", "l3_resilience"],
      "output_patterns": [
        ".shadow/L3-resilience/{slug}/failure-modes.md",
        ".shadow/L3-resilience/{slug}/failsafe-design.md",
        ".shadow/L3-resilience/{slug}/chaos-scenarios.md",
        ".shadow/L3-resilience/{slug}/resilience-test-plan.md",
        ".shadow/L3-resilience/{slug}/recovery-runbook.md"
      ]
    },
    {
      "id": "L5_Plan",
      "num": 9,
      "display": "L5 Plan",
      "skill": "shadow-l5-plan",
      "aliases": ["L5 Plan", "L5_Plan", "l5 plan", "l5_plan"],
      "output_patterns": [".shadow/L5-plan/{slug}/harness-plan.md"]
    },
    {
      "id": "L5_Impl",
      "num": 10,
      "display": "L5 Impl",
